{
  "manifest_version": 3,
  "name": "Leitor XML Fiscal",
  "description": "Atalho para colar um XML de NF-e ou NFS-e e abrir a analise no Leitor XML.",
  "version": "1.0.4",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leitor XML Fiscal",
    "default_icon": {
      "64": "assets/icon-64.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "64": "assets/icon-64.png",
    "128": "assets/logo-mark.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://leitor-xml-seven.vercel.app/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Abrir o atalho do Leitor XML"
    }
  }
}
